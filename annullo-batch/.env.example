# Credenziali e config per annullo_batch.py
# Copia in `.env` e riempi i valori. `.env` è git-ignored.

# Username per la chiamata /api/token (formato: dominio|utente)
ARCH_USERNAME=

# Operatore che risulta come autore dell'annullo
ARCH_OPERATORE=

# Data annullo nel formato dd/MM/yyyy (se vuota usa oggi)
ARCH_DATA_ANNULLO=

# Descrizione riportata nei Risultati
ARCH_VERIFICA_DESCRIZIONE=Copia della denuncia di furto

# --- Cookie sessione gestionale (obbligatori) ---
# Da DevTools del browser su http://bo.24hassistance.com (scadenza breve).
ARCH_COOKIE_SESSION=
ARCH_COOKIE_ASPXAUTH=
ARCH_COOKIE_RVT=

# --- Solo per modalità --audit (OCR con Claude) ---
# API key Anthropic (https://console.anthropic.com).
ANTHROPIC_API_KEY=
# Modello Claude da usare. Default: claude-opus-4-7 (più accurato, più costoso).
# Alternative: claude-sonnet-4-6 (bilanciato), claude-haiku-4-5 (più economico).
ANTHROPIC_MODEL=claude-opus-4-7
