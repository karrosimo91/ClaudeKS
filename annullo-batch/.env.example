# Credenziali e config per annullo_batch.py
# Copia in `.env` e riempi i valori. `.env` è git-ignored.

# Username per la chiamata /api/token (formato: dominio|utente)
ARCH_USERNAME=

# Operatore che risulta come autore dell'annullo
ARCH_OPERATORE=

# Data annullo nel formato dd/MM/yyyy (se vuota usa oggi)
ARCH_DATA_ANNULLO=

# Descrizione riportata nei Risultati
ARCH_VERIFICA_DESCRIZIONE=Copia della denuncia di furto
